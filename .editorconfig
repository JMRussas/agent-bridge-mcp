# Line endings are LF everywhere except Windows-native scripts. This mirrors
# .gitattributes so an editor writes what git expects and nothing is ever
# converted on the way in or out.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf

[*.{json,yml,yaml,svg,html,css,js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
