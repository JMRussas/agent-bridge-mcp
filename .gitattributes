# Line endings are decided here, not by each machine's core.autocrlf.
#
# Without this file every commit warned "LF will be replaced by CRLF", because
# autocrlf=true was converting on checkout while tooling wrote LF. Declaring the
# policy in the repo makes it consistent for everyone and silences the churn.
# One policy for every file, so a checkout looks the same on every machine.

# Normalise all text to LF in the repository and in the working tree.
* text=auto eol=lf

# Windows-native scripts keep CRLF so they behave in cmd/PowerShell hosts.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# --- Binaries -------------------------------------------------------------

*.png   binary
*.rgba  binary
*.exe   binary
*.dll   binary
*.pyc   binary
